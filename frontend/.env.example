# NDRS Frontend — Environment Variables

# Copy this file to .env for local development
# Set these variables in Vercel dashboard for production

# ─── Backend API URL ─────────────────────────────────────────────────────────
# Leave EMPTY for local dev (Vite proxy handles it)
# Set to your Render backend URL for production deployment
# Example: VITE_API_URL=https://ndrs-backend.onrender.com
VITE_API_URL=
