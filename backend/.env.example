# NDRS Backend — Environment Variables

# Copy this file to .env for local development
# Set these variables in Render dashboard for production

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ndrs_jwt_secret_change_in_production

# ─── Super Admin Seed Credentials ────────────────────────────────────────────
# These are used ONLY on first run to create the super admin account.
# After first run, change the password via the UI.
SUPER_ADMIN_EMAIL=superadmin@ndrs.gov.gh
SUPER_ADMIN_PASSWORD=NDRSAdmin2024!

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use local JSON file (./database.json) — good for development.
# On Render with a persistent disk, use /var/data/database.json.
# DATABASE_FILE=./database.json

# Optional future Postgres database URL for Neon or Supabase.
# The current backend uses JSON-file persistence; adding Postgres requires a data-layer migration.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
FRONTEND_URL=http://localhost:3000
